# Postgres connection. With Docker: postgres://mtg:mtg@localhost:5432/mtg
# Without Docker, `pnpm dev` starts an embedded PGlite server on port 5433.
DATABASE_URL=postgres://postgres:postgres@127.0.0.1:5433/postgres

# Better Auth
BETTER_AUTH_SECRET=change-me-to-a-long-random-string
BETTER_AUTH_URL=http://localhost:3000

# Anthropic (server-side only, never exposed to the browser)
ANTHROPIC_API_KEY=

# Scryfall: descriptive User-Agent required by Scryfall's API rules
SCRYFALL_USER_AGENT=mtg-deckbuilder-local/0.1 (+https://github.com/adam-riffi/mtg-deckbuilder)

# Set to "fixtures" to ingest the offline fixture dataset instead of Scryfall bulk data
INGEST_SOURCE=scryfall
