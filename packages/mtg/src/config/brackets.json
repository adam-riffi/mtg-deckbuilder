  "detectors": {
    "massLandDenial": {
      "tags": ["mass-land-denial", "land-destruction-mass"],
      "patterns": [
        "destroy all lands",
        "destroy all nonbasic lands",
        "each player sacrifices (?:all |a |two |three |four |five )?lands",
        "lands don't untap",
        "players can't untap more than one land",
        "return all lands to their owners' hands",
        "nonbasic lands are mountains",
        "exile all lands"
      ]
    },
    "extraTurns": {
      "tags": ["extra-turn"],
      "patterns": ["take an extra turn", "takes an extra turn", "extra turn after this one"]
    },
    "tutors": {
      "tags": ["tutor"],
      "patterns": [
        "search your library for (?:a|an|up to \\w+) (?!basic land|land card|plains|island|swamp|mountain|forest)[^.]*card"
      ]
    }
  }
