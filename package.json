{
  "name": "mtg-deckbuilder",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:web": "pnpm --filter @mtg/web dev",
    "dev:worker": "pnpm --filter @mtg/worker dev",
    "db:pglite": "pnpm --filter @mtg/db pglite",
    "db:migrate": "pnpm --filter @mtg/db migrate",
    "db:generate": "pnpm --filter @mtg/db generate",
    "ingest": "pnpm --filter @mtg/worker ingest",
    "ingest:fixtures": "pnpm --filter @mtg/worker ingest:fixtures",
    "fixtures:build": "tsx scripts/build-fixtures.ts",
    "evals": "pnpm --filter @mtg/ai evals",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "typecheck": "pnpm -r --parallel typecheck",
    "test": "pnpm -r test",
    "test:e2e": "pnpm --filter @mtg/web test:e2e",
    "prepare": "husky || true"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.5",
    "@types/node": "^24.10.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "vitest": "^5.1.0"
  },
  "lint-staged": {
    "*.{ts,tsx,js,mjs,json,css}": "biome check --write --no-errors-on-unmatched"
  }
}
